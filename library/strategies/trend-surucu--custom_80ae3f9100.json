            "type": "offset",
            "shift": 1,
            "operand": {
              "type": "math",
              "op": "mul",
              "left": {
                "type": "indicator",
                "id": "EMA",
                "params": {
                  "length": 200
                },
                "output": "value"
              },
              "right": {
                "type": "constant",
                "value": 0.98
              }
            }
          }
        }
      ]
    }
  }
