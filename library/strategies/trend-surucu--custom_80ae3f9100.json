  "definition": {
    "name": "Trend Sürücü",
    "description": "Al-tut'u geçmeyi hedefleyen trend takibi. AL: fiyat EMA200 üzerindeyken SuperTrend(40, 4) yukarıysa VEYA RSI(14) 45 ve altına indiyse (boğa rejiminde geri çekilme alımı). SAT: fiyat üst üste iki mum EMA200'ün %2 altında kapanırsa. 4h ve 1d'de al-tut'tan yüksek getiri, ~1/3 düşüş; 1h'de al-tut'a yakın getiri, yarı düşüş. 15m için tasarlanmadı.",
    "buy": {
      "logic": "AND",
      "conditions": [
        {
          "logic": "OR",
          "conditions": [
            {
              "left": {
                "type": "indicator",
                "id": "SUPERTREND",
                "params": {
                  "atr_length": 40,
                  "factor": 4
                },
                "output": "direction"
              },
              "op": "eq",
              "right": {
                "type": "constant",
                "value": 1
              }
            },
            {
              "left": {
                "type": "indicator",
                "id": "RSI",
                "params": {
                  "length": 14
                },
                "output": "value"
              },
              "op": "lte",
              "right": {
                "type": "constant",
                "value": 45
              }
            }
          ]
        },
        {
          "left": {
            "type": "price",
            "field": "close"
          },
          "op": "gt",
          "right": {
            "type": "indicator",
            "id": "EMA",
            "params": {
              "length": 200
            },
            "output": "value"
          }
        }
      ]
    },
    "sell": {
      "logic": "AND",
      "conditions": [
        {
          "left": {
            "type": "price",
            "field": "close"
          },
          "op": "lt",
          "right": {
            "type": "math",
            "op": "mul",
            "left": {
              "type": "indicator",
              "id": "EMA",
              "params": {
                "length": 200
              },
              "output": "value"
            },
            "right": {
              "type": "constant",
              "value": 0.98
            }
          }
        },
        {
          "left": {
            "type": "offset",
            "shift": 1,
            "operand": {
              "type": "price",
              "field": "close"
            }
          },
          "op": "lt",
