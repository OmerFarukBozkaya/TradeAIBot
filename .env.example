# ============================================================
# TradeAIBot yapılandırması (yalnızca ilk varsayılanlar)
# Bu dosyayı .env olarak kopyalayın.
# Tüm işlem, risk, Binance ve bildirim ayarları PANELDEN yönetilir:
#   Ayarlar sayfası → ilgili sekme
# .env yalnızca altyapı ve ilk varsayılanlar içindir.
# ============================================================

# --- Güvenlik ---
ADMIN_USER=admin
ADMIN_PASSWORD=DegistirBeni123!
# Boş bırakılırsa Data/.secret_key altında otomatik üretilir.
TRADEAI_SECRET_KEY=
TRADEAI_PORT=8080
# Panelin yayınlanacağı adres. 0.0.0.0 = yerel ağdaki tüm cihazlar erişebilir.
# Yalnızca bu makineden erişim için 127.0.0.1 yapın.
TRADEAI_BIND=0.0.0.0
TRADEAI_SESSION_HOURS=12
TRADEAI_COOKIE_SECURE=false
# Aynı tarayıcıda birden fazla panel açacaksanız her örneğe farklı ad verin
# (çerezler port ayrımı yapmaz; ör. uzak sunucuda tradeai_remote).
TRADEAI_COOKIE_NAME=tradeai_session

# --- İşlem güvenliği ---
# Panelden de değiştirilebilir (Ayarlar > İşlem).
LIVE_TRADING_ENABLED=true
DEFAULT_TRADE_MODE=paper
PAPER_FEE=0.001
PAPER_SLIPPAGE=0.0005
DEFAULT_CASH=100
BOT_AUTO_RESTART=true
BOT_HEARTBEAT_SECONDS=5
MAX_JOBS=2

# --- Binance ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
QUOTE_ASSET=USDT

# --- Bildirimler ---
MAIL_GONDER=false
GONDERICI_EMAIL=
GONDERICI_EMAIL_SIFRE=
ALICI_EMAIL=
TELEGRAM_MESAJ_GONDER=false
TELEGRAM_API_TOKEN=
TELEGRAM_CHAT_ID=

# --- Varsayılan risk ---
DINAMIK_STOP_LOSE=false
STATIC_STOP_LOSE=false
DESTEK_STOP_LOSE=true
TAKE_PROFIT=true
MAX_CANDLES=0

# --- Strateji limitleri ---
STRATEGY_LIMIT_15M=3
STRATEGY_LIMIT_1H=3
STRATEGY_LIMIT_4H=3
STRATEGY_LIMIT_1D=3

# --- AI eğitimi (panelden) ---
# AI Eğitimi sekmesini açmak ve model eğitmek için true yapın.
# Eğitim normal iş kuyruğunda, ayrı süreçte çalışır.
AI_ENABLED=false
