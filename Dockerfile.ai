# syntax=docker/dockerfile:1
# AI profili: aynı proje, AI bağımlılıkları dahil.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TZ=Europe/Istanbul

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc build-essential libgomp1 tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-ai.txt ./
RUN pip install --upgrade pip && pip install -r requirements-ai.txt

COPY . .
RUN mkdir -p Data Log state Trade_Durumu Trade_Durumu_AI

CMD ["python", "-m", "app.ai_worker"]
